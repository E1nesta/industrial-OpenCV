{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "mingw-debug",
      "displayName": "MinGW Debug",
      "description": "Current local-machine baseline: use Ninja with the active build/mingw-debug output directory.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/mingw-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_MAKE_PROGRAM": "G:/CODE/Tools/Ninja/ninja.exe",
        "CMAKE_CXX_COMPILER": "G:/CODE/Tools/mingw1310_64/bin/g++.exe",
        "VISION_USE_VCPKG": "ON",
        "VISION_REQUIRE_VIDEO_RUNTIME": "ON",
        "VCPKG_TARGET_TRIPLET": "x64-mingw-dynamic"
      }
    },
    {
      "name": "mingw-release",
      "displayName": "MinGW Release",
      "description": "Current local-machine baseline: use Ninja with the active build/mingw-release output directory.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/mingw-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_MAKE_PROGRAM": "G:/CODE/Tools/Ninja/ninja.exe",
        "CMAKE_CXX_COMPILER": "G:/CODE/Tools/mingw1310_64/bin/g++.exe",
        "VISION_USE_VCPKG": "ON",
        "VISION_REQUIRE_VIDEO_RUNTIME": "ON",
        "VCPKG_TARGET_TRIPLET": "x64-mingw-dynamic"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "mingw-debug",
      "configurePreset": "mingw-debug"
    },
    {
      "name": "mingw-release",
      "configurePreset": "mingw-release"
    }
  ]
}
